# Optional gateway defaults. Copy to .env; do not commit your actual key.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=

# Optional: lock all AI runs to a restricted OmniRoute model/combo.
# Use a gateway key whose model, combo and connection allowlists exclude paid routes.
ULTHARNESS_OMNIROUTE_ONLY=0
ULTHARNESS_OMNIROUTE_MODEL=ultharness-free

# Optional direct OpenRouter route (select OpenRouter in Model routing).
OPENROUTER_API_KEY=
# Optional local OpenClaw gateway authentication for the inspection MCP bridge.
OPENCLAW_GATEWAY_TOKEN=
